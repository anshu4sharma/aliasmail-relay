# Server Port
PORT=3000

# Webhook Secret configured on AliasMail (for HMAC-SHA256 verification)
ALIASMAIL_WEBHOOK_SECRET=your_hmac_signing_secret_here

# Destination forwarding URLs (comma-separated or single)
FORWARD_URLS=http://localhost:8080/incoming-mail

# Optional integrations
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
